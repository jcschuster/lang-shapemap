{
  "name": "lang-shapemap",
  "private": true,
  "description": "Editor language support for ShapeMap, generated from the grammar of the ShapeMap Structure and Language specification",
  "scripts": {
    "generate": "node gen/ebnf2lezer.mjs",
    "build": "pnpm -r run build",
    "test": "node --test gen/ && node .github/scripts/check-fixtures.mjs && pnpm -r test"
  },
  "license": "MIT",
  "engines": {
    "node": "^26"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "shape-map": "^1.1.0"
  }
}
