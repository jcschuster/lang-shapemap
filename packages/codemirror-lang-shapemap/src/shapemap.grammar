// Hand-written part of src/shapemap.grammar. gen/ebnf2lezer.mjs adds a rule per production
// and a token per terminal of the grammar in spec/. A rule here named like a production must
// repeat the generated body and only adds a @top, props or conflict markers. The lines
// starting with @hidden and @unused are read by the generator, not by Lezer.
// gen/CONFLICTS.md explains each entry.

@skip { whitespace | LineComment }

@external propSource shapemapHighlighting from "./highlight"

@detectDelim

// One rule per production, in the order of the grammar.

@top ShapeMap {
  ShapeAssociation ("," ShapeAssociation)*
}

ShapeAssociation {
  NodeSelector ShapeLabel
}

NodeSelector {
  objectTerm |
  TriplePattern
}

subjectTerm {
  Iri
}

objectTerm {
  subjectTerm |
  literal
}

TriplePattern {
  "{" "FOCUS" Predicate (objectTerm | "_") "}" |
  "{" (subjectTerm | "_") Predicate "FOCUS" "}"
}

ShapeLabel {
  "@" (Iri | "START") |
  AtStart |
  AtpnameNs |
  AtpnameLn
}

literal {
  RdfLiteral |
  NumericLiteral |
  BooleanLiteral
}

NumericLiteral {
  Integer |
  Decimal |
  Double
}

RdfLiteral {
  LangString |
  String ("^^" Iri)?
}

BooleanLiteral {
  "true" |
  "false"
}

String {
  StringLiteral1 |
  StringLiteralLong1 |
  StringLiteral2 |
  StringLiteralLong2
}

LangString {
  LangStringLiteral1 |
  LangStringLiteralLong1 |
  LangStringLiteral2 |
  LangStringLiteralLong2
}

Iri {
  Iriref |
  PrefixedName
}

Predicate {
  Iri |
  RdfType
}

PrefixedName {
  PnameLn |
  PnameNs
}

@top Unused {
  BlankNodeLabel
}

@tokens {
  Iriref { "<" (![\u{0}- "<>\\^`{-}] | uchar)* ">" }

  BlankNodeLabel { "_:" (pnCharsU | $[0-9]) ((pnChars | ".")* pnChars)? }

  AtStart { "@START" }

  langtag { "@" $[A-Za-z]+ ("-" $[0-9A-Za-z]+)* }

  Integer { $[+\-]? $[0-9]+ }

  Decimal { $[+\-]? $[0-9]* "." $[0-9]+ }

  Double { $[+\-]? ($[0-9]+ "." $[0-9]* exponent | "."? $[0-9]+ exponent) }

  exponent { $[Ee] $[+\-]? $[0-9]+ }

  StringLiteral1 { "'" (![\u{a}\u{d}'\\] | echar | uchar)* "'" }

  StringLiteral2 { "\"" (![\u{a}\u{d}"\\] | echar | uchar)* "\"" }

  StringLiteralLong1 { "'''" (("'" | "''")? (!['\\] | echar | uchar))* "'''" }

  StringLiteralLong2 { "\"\"\"" (("\"" | "\"\"")? (!["\\] | echar | uchar))* "\"\"\"" }

  LangStringLiteral1 { "'" (![\u{a}\u{d}'\\] | echar | uchar)* "'" langtag }

  LangStringLiteral2 { "\"" (![\u{a}\u{d}"\\] | echar | uchar)* "\"" langtag }

  LangStringLiteralLong1 { "'''" (("'" | "''")? (!['\\] | echar | uchar))* "'''" langtag }

  LangStringLiteralLong2 { "\"\"\"" (("\"" | "\"\"")? (!["\\] | echar | uchar))* "\"\"\"" langtag }

  uchar { "\\u" hex hex hex hex | "\\U" hex hex hex hex hex hex hex hex }

  echar { "\\" $["'\\bfnrt] }

  pnCharsBase { $[A-Z] | $[a-z] | $[\u{c0}-\u{d6}] | $[\u{d8}-\u{f6}] | $[\u{f8}-\u{2ff}] | $[\u{370}-\u{37d}] | $[\u{37f}-\u{1fff}] | $[\u{200c}-\u{200d}] | $[\u{2070}-\u{218f}] | $[\u{2c00}-\u{2fef}] | $[\u{3001}-\u{d7ff}] | $[\u{f900}-\u{fdcf}] | $[\u{fdf0}-\u{fffd}] | $[\u{10000}-\u{effff}] }

  pnCharsU { pnCharsBase | "_" }

  pnChars { pnCharsU | "-" | $[0-9] | $[\u{b7}] | $[\u{300}-\u{36f}] | $[\u{203f}-\u{2040}] }

  pnPrefix { pnCharsBase ((pnChars | ".")* pnChars)? }

  pnLocal { (pnCharsU | ":" | $[0-9] | plx) ((pnChars | "." | ":" | plx)* (pnChars | ":" | plx))? }

  plx { percent | pnLocalEsc }

  percent { "%" hex hex }

  hex { $[0-9] | $[A-F] | $[a-f] }

  pnLocalEsc { "\\" ("_" | "~" | "." | "-" | "!" | "$" | "&" | "'" | "(" | ")" | "*" | "+" | "," | ";" | "=" | "/" | "?" | "#" | "@" | "%") }

  RdfType { "a" }

  PnameNs { pnPrefix? ":" }

  PnameLn { PnameNs pnLocal }

  AtpnameNs { "@" pnPrefix? ":" }

  AtpnameLn { "@" PnameNs pnLocal }

  whitespace { $[\u{9}-\u{a}\u{d} ]+ }

  LineComment { "#" ![\u{a}\u{d}]* }

